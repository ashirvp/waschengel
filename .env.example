# Lexware / lexoffice API key (needs a plan that includes the public API)
# Get it at: https://app.lexware.de/addons/public-api
LEXWARE_API_KEY=

# Enables the setup report at /admin?token=... in a browser, so you can check
# the configuration without a terminal. Leave EMPTY to disable the page
# entirely. Use a long random value — the report shows customer names, email
# addresses and your Lexware account name.
ADMIN_TOKEN=

# Let the app CREATE a dealer customer in Lexware when the name doesn't match.
# Leave this off: you want a clear error, not a bare duplicate contact with no
# address on a real invoice.
LEXWARE_CREATE_CONTACTS=false

# Put the Lexware article id on the invoice line instead of writing it as free
# text. Better bookkeeping, but send ONE test invoice and check it in Lexware
# before relying on it.
LEXWARE_LINK_ARTICLES=false

PORT=3000

# How the service date appears on the invoice. Lexware requires
# shippingConditions; "service" means the work was done on that date. Change it
# only if your account rejects that value (delivery, serviceperiod,
# deliveryperiod, none).
LEXWARE_SHIPPING_TYPE=service
