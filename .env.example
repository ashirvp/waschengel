# Lexware / lexoffice API key (needs a plan that includes the public API)
# Get it at: https://app.lexware.de/addons/public-api
LEXWARE_API_KEY=

# OPTIONAL billing-email overrides.
# Leave these EMPTY normally: each invoice then goes to the email on that
# customer's record in Lexware (Scuderia Feser Graf GmbH, Feser Sportwagen
# GmbH, Feser Graf Exclusive Cars GmbH). Set one only to redirect a company's
# invoices somewhere else, e.g. a shared accounts-payable inbox.
LAMBO_MCLAREN_BILLING_EMAIL=
FERRARI_BILLING_EMAIL=
BENTLEY_BILLING_EMAIL=

# SMTP settings used to email the invoice PDF after creation
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=garage@yourcompany.com

# Where the vehicle registry (plate -> customer) and the contact-id cache are
# kept. MUST point at a persistent volume in production, or every redeploy
# forgets every car. Defaults to ./data for local use.
DATA_DIR=

# Let the app CREATE a dealer customer in Lexware when the name doesn't match.
# Leave this off: you want a clear error, not a bare duplicate contact with no
# address on a real invoice.
LEXWARE_CREATE_CONTACTS=false

PORT=3000
