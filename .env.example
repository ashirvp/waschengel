# Lexware / lexoffice API key (needs Lexware Office XL plan)
# Get it at: https://app.lexware.de/addons/public-api
LEXWARE_API_KEY=

# Billing email for each customer company.
# These keys match the company keys in src/config.js
LAMBO_MCLAREN_BILLING_EMAIL=invoices@company-one.com
FERRARI_BILLING_EMAIL=invoices@company-two.com
BENTLEY_BILLING_EMAIL=invoices@company-three.com

# SMTP settings used to email the invoice PDF after creation
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=garage@yourcompany.com

PORT=3000
